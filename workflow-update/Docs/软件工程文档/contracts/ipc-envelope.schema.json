{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fpcad:ipc-envelope:v1",
  "title": "FPCAD IPC Request Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "requestId",
    "method",
    "payload"
  ],
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "method": {
      "enum": [
        "project.create",
        "project.open",
        "project.save",
        "project.snapshot",
        "command.apply",
        "command.undo",
        "command.redo",
        "reference.calibrate",
        "body.setParameters",
        "pattern.offset",
        "pattern.boolean",
        "seam.link",
        "job.submit",
        "job.cancel",
        "result.accept",
        "result.discard",
        "validation.run",
        "export.create",
        "feature.list"
      ]
    },
    "projectId": {
      "type": "string",
      "format": "uuid"
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "method": {
            "enum": [
              "project.save",
              "command.apply",
              "command.undo",
              "command.redo",
              "reference.calibrate",
              "body.setParameters",
              "seam.link",
              "result.accept"
            ]
          }
        }
      },
      "then": {
        "required": [
          "projectId",
          "expectedRevision"
        ]
      }
    }
  ]
}
